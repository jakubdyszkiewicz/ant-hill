{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "schedule": [
    "* 0-6 * * 6"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images in the Jinja compose template (not valid YAML, so the docker-compose manager can't parse it)",
      "managerFilePatterns": [
        "/templates/docker-services/docker-compose\\.yaml\\.j2$/"
      ],
      "matchStrings": [
        "image:\\s*\"?(?<depName>[^\\s:@\"]+):(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "image: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Versions annotated with '# renovate: datasource=... depName=...' (Docker Compose plugin in the playbook, ansible-core in CI)",
      "managerFilePatterns": [
        "/^ant-services\\.yaml$/",
        "/^\\.github/workflows/ansible-deploy\\.yaml$/"
      ],
      "matchStrings": [
        "(?<currentValue>v?[0-9][0-9.]*) # renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*pipx install [a-z-]+==(?<currentValue>[0-9][0-9.]*)"
      ]
    },
    {
      "customType": "regex",
      "description": "dotfishy commit pinned for ant-services (the dotfiles role)",
      "managerFilePatterns": [
        "/^ant-services\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n\\s*dotfiles_version: \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "My own images: updated by hand for now",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/jakubdyszkiewicz/**",
        "jakubdyszkiewicz/**"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "linuxserver/**"
      ],
      "groupName": "linuxserver"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "prom/**",
        "grafana/**",
        "ghcr.io/google/cadvisor"
      ],
      "groupName": "observability"
    },
    {
      "description": "Same-version rebuilds (digest-only) in one weekly PR instead of one per image",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "docker digests"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Postgres majors need a manual dump/restore or pg_upgrade; Postgres data can't be upgraded by swapping the image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "MariaDB: stay on the 12.3 LTS. 13.0 is a short-term rolling release; next LTS is 13.3. Relax this once 13.3 is out.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "allowedVersions": "<13"
    },
    {
      "description": "Home Assistant: approve every release on the dashboard. Monthly releases count as 'minor' but carry breaking changes (2026.3 removed light 'kelvin'); review the release notes first.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "timezone": "Europe/Warsaw",
  "prHourlyLimit": 0
}
