#cloud-config
hostname: {{ vm_name }}
password: {{ vm_root_password }}
chpasswd: { expire: False }
disable_root: false
ssh_authorized_keys:
{% for key in ssh_authorized_keys %}
  - {{ key }}
{% endfor %}
{% if vm_swap_size | string != "0" %}
swap:
  filename: /swapfile
  size: {{ vm_swap_size }}
{% endif %}
