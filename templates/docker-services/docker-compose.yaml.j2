---
x-logging:
  &default-logging
  driver: "json-file"
  options:
    tag: "{% raw %}{{ .Name }}{% endraw %}"

services:
  plex:
    image: linuxserver/plex:1.43.5@sha256:9a1325bf0b34a50993a04be0bdcc7fab841d2a78161bd11b4db4ff8478a7ac2a
    container_name: plex
    environment:
      - PUID=1000
      - PGID=1000
      - VERSION=docker
    ports:
      - 32400:32400
      - "32410:32410/udp"
      - "32412:32412/udp"
      - "32413:32413/udp"
      - "32414:32414/udp"
    volumes:
      - /mnt/data/services/plex:/config
      - /mnt/media/movies:/movies
      - /mnt/media/tvshows:/tvshows
      - /mnt/media/music:/music
    logging: *default-logging
    restart: unless-stopped
  syncthing:
    image: linuxserver/syncthing:2.1.7@sha256:c4207d8f5b66d5f67eedb636b75500b5a04898e9f33299d252f4b966c41a4128
    container_name: syncthing
    volumes:
      - /mnt/data/services/syncthing:/config
      - /mnt/data/sync:/mnt/data/sync
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
    ports:
      - 22000:22000/tcp
      - 22000:22000/udp
      - 21027:21027/udp
    expose:
      - 8343
    logging: *default-logging
  syncthing-healthcheck:
    image: jakubdyszkiewicz/syncthing-healthcheck:0.0.1@sha256:8646197fec8d8d88bfe43b78ba88216aa18aa48970c5c097b75f4a8682badc4d
    container_name: syncthing-healthcheck
    volumes:
      - /home/{{ ansible_user }}/docker-services/syncthing-healthcheck:/config
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
      - SYNCTHING_API_KEY={{ syncthing_api_key }}
    logging: *default-logging
  nzbget:
    image: linuxserver/nzbget:26.3.20261113@sha256:17e13511d47b1439af19b7ef17d08c8643eb2a5f009b1d3f800b704ebe590218
    container_name: nzbget
    volumes:
      - /mnt/data/services/nzbget:/config
      - /home/{{ ansible_user }}/docker-services/data/downloads:/downloads
    restart: always
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
    expose:
      - 6789
    logging: *default-logging
  sonarr:
    image: linuxserver/sonarr:4.0.20@sha256:c7d1df25e428da6c9ace05daea0d34e59522978a3843ea1944812f855af4086c
    container_name: sonarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=PST
      - UMASK_SET=022 #optional
    volumes:
      - /mnt/data/services/sonarr:/config
      - /mnt/media/tvshows:/mnt/media/tvshows
      - /home/{{ ansible_user }}/docker-services/data/downloads:/downloads
    expose:
      - 8989
    logging: *default-logging
    restart: unless-stopped
  radarr:
    image: linuxserver/radarr:7.0.3@sha256:044788f5508b7f67a3e0368cdd142c77c4d4cd5aec2efaba53e1a68b6b6231e7
    container_name: radarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=PST
    volumes:
      - /mnt/data/services/radarr:/config
      - /mnt/media/movies:/mnt/media/movies
      - /home/{{ ansible_user }}/docker-services/data/downloads:/downloads
    expose:
      - 7878
    logging: *default-logging
    restart: unless-stopped
  readarr:
    image: linuxserver/readarr:0.4.18-develop@sha256:baf471a7101b58f361ef960de91cd15f23bae82d0126df6a9edbeaf5c5aa4392
    container_name: readarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=PST
      - UMASK_SET=022 #optional
    volumes:
      - /mnt/data/services/readarr:/config
      - /mnt/media/books:/mnt/media
      - /home/{{ ansible_user }}/docker-services/data/downloads:/downloads
    expose:
      - 8787
    logging: *default-logging
    restart: unless-stopped
  bazarr:
    image: linuxserver/bazarr:1.6.2@sha256:e0c5d45965242830c5eeddaafe9ae2b5e8ca3f6c01ecda9ee9364f550921dc50
    container_name: bazarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
      - UMASK_SET=022 #optional
    volumes:
      - /mnt/data/services/bazarr:/config
      - /mnt/media/tvshows:/mnt/media/tvshows # this path has to be the same as in Sonarr
      - /mnt/media/movies:/mnt/media/movies # # this path has to be the same as in Radarr
    expose:
      - 6767
    logging: *default-logging
    restart: unless-stopped
  adguardhome:
    image: adguard/adguardhome:v1.0.0@sha256:f00a586f0d1caa74f149340bfb225014960310488ffa838406b89256900a96c2
    container_name: adguardhome
    ports: # bind only to specific network interface, 0.0.0.0 has a clash with builtin Ubuntu systemd caching DNS on 127.0.0.1
      - "{{ inventory_hostname }}:53:53/tcp"
      - "{{ inventory_hostname }}:53:53/udp"
      - "3000:3000/tcp" # do not hide it in Kong yet. I need DNS to access all services in local network
    volumes:
      - /mnt/data/services/adguardhome/work:/opt/adguardhome/work
      - /mnt/data/services/adguardhome/conf:/opt/adguardhome/conf
    logging: *default-logging
    restart: unless-stopped
  ddclient:
    image: linuxserver/ddclient:4.0.0@sha256:8daff71cbdc8ef9b9e2db35617dcff250f3f219fe3f8110940107ceed0f9eb7b # stale
    container_name: ddclient
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
    volumes:
      - /home/{{ ansible_user }}/docker-services/ddclient:/config
    logging: *default-logging
    restart: unless-stopped
  duplicacy:
    image: saspus/duplicacy-web:v1.8.3@sha256:c51e896c36f76e54669ad9aa2ed98314f8c603a3d1cebbe236d1ad4d43cb6030
    container_name: duplicacy
    hostname: duplicacy-web
    restart: unless-stopped
    expose:
      - 3875
    environment:
      - USR_ID=1000
      - GRP_ID=1000
      - TZ=Europe/Warsaw
    volumes:
      - /mnt/data/services/duplicacy:/config
      - /home/jakub/docker-services/duplicacy/cache:/cache
      - /home/jakub/docker-services/duplicacy/logs:/logs
      - /mnt/data:/data:ro
    logging: *default-logging
  gickup:
    container_name: gickup
    image: buddyspencer/gickup:0.10.47@sha256:a0307e9c131b45b0d2039417f291b7ef44580d9d9e303bb5a6083aaf82691044
    restart: unless-stopped
    user: '1000:1000'
    volumes:
      - /home/{{ ansible_user }}/docker-services/gickup/conf.yml:/gickup/conf.yml
      - /mnt/data/gickup:/data
    logging: *default-logging
  rclone:
    container_name: rclone
    image: rclone/rclone:1.76.0@sha256:7cbeec24a44f206067597c0368be4de90ae19a64d5113c7d1938bd737a81e466
    restart: unless-stopped
    user: '1000:1000'
    volumes:
      - /home/{{ ansible_user }}/docker-services/rclone:/config/rclone
      - /mnt/data/gdrive:/data
    entrypoint: ["/bin/sh", "/config/rclone/loop.sh"]
    logging: *default-logging
  kong:
    image: kong/kong-gateway:3.16.0.3@sha256:10bc524c16dd8857b8b8d9baa4fa700d7c1fda5e96c5f3fd4ca5b82761589911
    user: '1000:1000'
    container_name: kong
    environment:
      - KONG_PREFIX=/tmp/ # the default /usr/local/kong is not writable by non-root user
      - KONG_DATABASE=off
      - KONG_DECLARATIVE_CONFIG=/usr/local/kong/declarative/kong.yml
      - KONG_PROXY_ACCESS_LOG=/dev/stdout
      - KONG_ADMIN_ACCESS_LOG=/dev/stdout
      - KONG_PROXY_ERROR_LOG=/dev/stderr
      - KONG_ADMIN_ERROR_LOG=/dev/stderr
      - KONG_PROXY_LISTEN=0.0.0.0:8080, 0.0.0.0:8443 ssl
      - KONG_SSL_CERT=/certs/live/{{ ant_domain }}/fullchain.pem
      - KONG_SSL_CERT_KEY=/certs/live/{{ ant_domain }}/privkey.pem
      - KONG_MEM_CACHE_SIZE=32m
      - KONG_NGINX_WORKER_PROCESSES="1"
    ports:
      - 443:8443
    volumes:
      - /home/{{ ansible_user }}/docker-services/kong:/usr/local/kong/declarative
      - /home/{{ ansible_user }}/docker-services/kong/license.json:/etc/kong/license.json
      - /mnt/data/services/swag/etc/letsencrypt:/certs
    restart: unless-stopped
    logging: *default-logging
  swag:
    image: linuxserver/swag:5.10.0@sha256:64eb21f795cb7aa58c6a95c4c7c1b780cb86d48dbf8283ca0c27d7bb5983b3c0
    container_name: swag
    cap_add:
      - NET_ADMIN
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
      - URL={{ ant_domain }}
      - VALIDATION=dns
      - PROPAGATION=60
      - SUBDOMAINS=wildcard
      - DNSPLUGIN=ovh
      - "EMAIL=jakub.dyszkiewicz@gmail.com"
      - STAGING=false
    volumes:
      - /mnt/data/services/swag:/config
    restart: unless-stopped
    logging: *default-logging
  samba:
    image: crazymax/samba:4.23.8@sha256:b37f7af97c773eddb593537f64da6389e5ee6695bcecf44f3ba1a8a6bcf34125
    container_name: samba
    volumes:
      - /home/{{ ansible_user }}/docker-services/samba:/data
      - /mnt/data/nas:/nas
    environment:
      - TZ=Europe/Warsaw
      - SAMBA_LOG_LEVEL=0
    ports:
      - 445:445
    restart: unless-stopped
    logging: *default-logging
  nodeexporter:
    image: prom/node-exporter:v1.13.1@sha256:7296504d4ada44b7d7ab4431e27e9f9900d8488f8d55842f4b12ae2704e16dfe
    container_name: nodeexporter
    network_mode: host # required to collect data about host network
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /run/udev:/run/udev:ro # device labels (model, serial, path) for diskstats
    command:
      - '--path.procfs=/host/proc'
      - '--path.rootfs=/rootfs'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    restart: unless-stopped
    expose:
      - 9100
    logging: *default-logging
  prometheus:
    image: prom/prometheus:v3.16.0@sha256:e04987641b57704f408e31f6373ba4138ecf27cb4a165d24aabb6c38fddd0f06
    container_name: prometheus
    user: '1000:1000'
    extra_hosts: # required to collect data from nodeexporter
      - "host.docker.internal:host-gateway"
    volumes:
      - /home/{{ ansible_user }}/docker-services/prometheus:/etc/prometheus
      - /home/{{ ansible_user }}/docker-services/data/prometheus:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=8760h'
      - '--storage.tsdb.retention.size=50GB'
      - '--web.enable-lifecycle'
    restart: unless-stopped
    expose:
      - 9090
    logging: *default-logging
  grafana:
    image: grafana/grafana:13.3.1@sha256:0615ec4fbd4072004b7d86b46ded63013a74b7d6eb1119273dd89e8fa25c13cf
    container_name: grafana
    user: '1000:1000'
    volumes:
      - /mnt/data/services/grafana:/var/lib/grafana
      - /home/{{ ansible_user }}/docker-services/grafana:/etc/grafana/provisioning
    environment:
      - GF_AUTH_ANONYMOUS_ENABLED=true # secured via Kong
      - GF_AUTH_DISABLE_LOGIN_FORM=true # secured via Kong
      - GF_AUTH_ANONYMOUS_ORG_ROLE=Editor
      - GF_USERS_ALLOW_SIGN_UP=false
    expose:
      - 3000
    restart: unless-stopped
  cadvisor:
    image: ghcr.io/google/cadvisor:v0.61.1@sha256:4929b70e82079d001d0028b85d6a4dd25ad4666b719455c9542b983489963916
    container_name: cadvisor
    privileged: true
    devices:
    - /dev/kmsg:/dev/kmsg
    volumes:
    - /:/rootfs:ro
    - /var/run:/var/run:rw
    - /sys:/sys:ro
    - /sys/fs/cgroup:/sys/fs/cgroup:ro
    - /var/lib/docker:/var/lib/docker:ro
    - /dev/disk:/dev/disk:ro
    restart: unless-stopped
    expose:
    - "8080"
    logging: *default-logging
  telegraf: # per-container restart count, state, exit code, health
    image: telegraf:1.40.3-alpine@sha256:10fe8c974752c8088858f012cb47b71f5bb67c5695829be56d87dfbf8e0092b8
    container_name: telegraf
    user: "telegraf:{{ docker_sock_gid }}" # docker socket group, read by Ansible
    volumes:
    - /home/{{ ansible_user }}/docker-services/telegraf/telegraf.conf:/etc/telegraf/telegraf.conf:ro
    - /var/run/docker.sock:/var/run/docker.sock:ro
    restart: unless-stopped
    expose:
    - "9273"
    logging: *default-logging
  speedtest:
    image: ghcr.io/danopstech/speedtest_exporter:v0.0.5@sha256:99efbe55412b0a328d5827fab8dbcc2286093d4ad0d369e4e9b7e3c4153793be
    container_name: speedtest
    restart: unless-stopped
    expose:
      - 9090
    logging: *default-logging
  promtail:
    image: grafana/promtail:3.6.11@sha256:a761cb834cfaeee29745440d4884d6748f0a08d8f68928db1d707018c1dcfbe9
    container_name: promtail
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers
      - /home/{{ ansible_user }}/docker-services/promtail/docker-config.yml:/etc/promtail/docker-config.yml
    command: -config.file=/etc/promtail/docker-config.yml
    logging: *default-logging
  loki:
    image: grafana/loki:3.7.10@sha256:b43c257ccfc925d4a50b8717cac61a3b51df8c48d01847936057e5c4075a24a7
    container_name: loki
    expose:
      - 3100
    command: -config.file=/config/config.yml
    volumes:
      - /home/{{ ansible_user }}/docker-services/loki:/config
    logging: *default-logging
  antui:
    image: jakubdyszkiewicz/ant-ui:0.0.1@sha256:88686fca1b99be38b4d010dc51364894684f8568aaba3cd7ba604dbdbe3b59cb
    container_name: antui
    expose:
      - 80
    logging: *default-logging
  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:2025.7.1@sha256:e876528e4159974e844bbf3555e67ff48d73a78bf432b717dd9d178328230b40
    volumes:
      - /mnt/data/services/homeassistant:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    ports:
      - 8123:8123
      - 21064:21064
    logging: *default-logging
  mdns-repeater:
    image: jdbeeler/mdns-repeater:latest@sha256:3f5ccbef79b7c2f79ee33658e1f76600cdccb54c65d1d327c89fe9db6f037dc5
    container_name: mdns-repeater
    restart: unless-stopped
    network_mode: host
    privileged: true
    environment:
      - EXTERNAL_INTERFACE=enp1s0
      - DOCKER_NETWORK_NAME=docker-services_default
      - USE_MDNS_REPEATER=1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    logging: *default-logging
  mqtt:
    container_name: mqtt
    image: eclipse-mosquitto:2.0.23@sha256:6a332cc7a8dbe011cbc076180cbb76b37c6f0f55809682ea08e7980ef0112ad9
    restart: unless-stopped
    volumes:
      - /mnt/data/services/mqtt:/mosquitto
    expose:
      - 1883
      - 9001
    command: "mosquitto -c /mosquitto-no-auth.conf"
  zigbee2mqtt:
    container_name: zigbee2mqtt
    restart: unless-stopped
    image: koenkk/zigbee2mqtt:1.42.0@sha256:732ae43d714610040bd049487b60af3b2dbcfdefb5f169897455b60d715e2131
    volumes:
      - /mnt/data/services/zigbee2mqtt:/app/data
      - /run/udev:/run/udev:ro
    expose:
      - 8080
    environment:
      - TZ=Europe/Warsaw
    devices:
      - /dev/ttyACM0:/dev/ttyACM0
  calendar-fetcher:
    image: alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    container_name: calendar-fetcher
    volumes:
      - /home/{{ ansible_user }}/docker-services/calendar-fetcher:/app
      - /mnt/data/calendar:/data
    entrypoint: ["/bin/sh", "/app/loop.sh"]
    restart: unless-stopped
    logging: *default-logging
  spotify-exporter:
    container_name: spotify-exporter
    restart: unless-stopped
    image: jakubdyszkiewicz/spotify-exporter:v0.0.5@sha256:4cff830ed9adcb3927672f0d1329ae9052464c34ce455433014cae771fd205a3
    volumes:
      - /home/{{ ansible_user }}/docker-services/spotify-exporter/config.toml:/app/config.toml
      - /mnt/data/services/spotify-exporter/auth-cache:/app/auth-cache
      - /mnt/data/services/spotify-exporter/out:/app/data
    expose:
      - 8888
    environment:
      - TZ=Europe/Warsaw
    logging: *default-logging
  actual:
    container_name: actual
    restart: unless-stopped
    image: actualbudget/actual-server:26.11.0@sha256:06cf186569cf58d93e12659ff1a517b65b5b0ebee7050a3991d4bd8a1d398da6
    volumes:
      - /mnt/data/services/actual:/data
    expose:
      - 5006
    environment:
      - TZ=Europe/Warsaw
    logging: *default-logging
  actual-mcp:
    container_name: actual-mcp
    restart: unless-stopped
    image: sstefanov/actual-mcp:v1.15.1@sha256:9d6b216146fcd5f59303945d4f47ee6cbfbdc12a4f6a66f52029507e4ad0cb93
    expose:
      - 3000
    ports:
      - 13000:3000
    environment:
      - TZ=Europe/Warsaw
      - ACTUAL_SERVER_URL=http://actual:5006
      - ACTUAL_PASSWORD={{ actual_password }}
      - ACTUAL_BUDGET_SYNC_ID=5e2afa2a-b8d5-4757-9039-73e219c97d6c
      - BEARER_TOKEN={{ actual_mcp_token }}
    command: ["--sse", "--enable-write", "--enable-bearer"]
  paperless-redis:
    container_name: paperless-redis
    image: docker.io/library/redis:8.10.3@sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
    restart: unless-stopped
    volumes:
      - /mnt/data/services/paperless/redis:/data
  paperless:
    container_name: paperless
    image: ghcr.io/paperless-ngx/paperless-ngx:3.5.1@sha256:8508853b8a0f8394074260957d0be186c8c64f346973b24a7583de4580f306b9
    restart: unless-stopped
    depends_on:
      - paperless-redis
    volumes:
      - /mnt/data/services/paperless/data:/usr/src/paperless/data
      - /mnt/data/services/paperless/media:/usr/src/paperless/media
      - /mnt/data/services/paperless/export:/usr/src/paperless/export
      - /mnt/data/services/paperless/consume:/usr/src/paperless/consume
    environment:
      - PAPERLESS_TIME_ZONE=Europe/Warsaw
      - PAPERLESS_URL=https://paperless.{{ ant_domain }}
      - "PAPERLESS_OCR_LANGUAGE=pol+eng"
      - PAPERLESS_OCR_LANGUAGES=pol
      - PAPERLESS_REDIS=redis://paperless-redis:6379
      - PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
  romm:
    image: rommapp/romm:5.4.1@sha256:8677fb7b81b1d3db20b849e989a1dadc2a11159e51eb34a2acdcb01102274edf
    container_name: romm
    restart: unless-stopped
    environment:
      - DB_HOST=romm-db
      - DB_NAME=romm # Should match MARIADB_DATABASE in mariadb
      - DB_USER=romm-user # Should match MARIADB_USER in mariadb
      - DB_PASSWD={{ romm_db_passwd }}
      - ROMM_AUTH_SECRET_KEY={{ romm_auth_key }}
      - SCREENSCRAPER_USER=jacqud # These are the recommended metadata providers
      - SCREENSCRAPER_PASSWORD={{ screenscraper_fr_password }} # https://docs.romm.app/latest/Getting-Started/Metadata-Providers/#screenscraper
      - RETROACHIEVEMENTS_API_KEY={{ retroachievements_api_key }} # https://docs.romm.app/latest/Getting-Started/Metadata-Providers/#retroachievements
      - STEAMGRIDDB_API_KEY={{ steamgriddb_api_key }} # https://docs.romm.app/latest/Getting-Started/Metadata-Providers/#steamgriddb
      - HASHEOUS_API_ENABLED=true # https://docs.romm.app/latest/Getting-Started/Metadata-Providers/#hasheous
    volumes:
      - /mnt/data/services/romm/resources:/romm/resources # Resources fetched from IGDB (covers, screenshots, etc.)
      - /mnt/data/services/romm/redis-data:/redis-data # Cached data for background tasks
      - /mnt/data/services/romm/library:/romm/library # Your game library. Check https://docs.romm.app/latest/Getting-Started/Folder-Structure/ for more details.
      - /mnt/data/services/romm/assets:/romm/assets # Uploaded saves, states, etc.
      - /home/{{ ansible_user }}/docker-services/romm:/romm/config # config.yml, managed in this repo
    depends_on:
      romm-db:
        condition: service_healthy
        restart: true
    ports:
      - 18082:8080
  romm-db:
    image: mariadb:12.3.3@sha256:4ebbcf100a3ba320766dfa0e1af008df12261301db6ef72798c7650f70794aed
    container_name: romm-db
    restart: unless-stopped
    environment:
      - MARIADB_ROOT_PASSWORD={{ romm_db_passwd }} # Use a unique, secure password
      - MARIADB_DATABASE=romm
      # Run mariadb-upgrade on start when the server version changes (with a backup).
      - MARIADB_AUTO_UPGRADE=1
      - MARIADB_USER=romm-user
      - MARIADB_PASSWORD={{ romm_db_passwd }}
    volumes:
      - /mnt/data/services/romm/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 30s
      start_interval: 10s
      interval: 10s
      timeout: 5s
      retries: 5
  bubblewrap-postgres:
    image: docker.io/library/postgres:16.16-alpine@sha256:1d5b02d3a9941fbd52437db4107f8c52d6297dac553ca1e5c299ebb3756b4857
    container_name: bubblewrap-postgres
    restart: unless-stopped
    environment:
      - TZ=Europe/Warsaw
      - POSTGRES_DB=bubblewrap
      - POSTGRES_USER=app
      - POSTGRES_PASSWORD={{ bubblewrap_postgres_password }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d bubblewrap -U app"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - /mnt/data/services/bubblewrap/postgres:/var/lib/postgresql/data
    logging: *default-logging
  bubblewrap-minio:
    image: quay.io/minio/minio:RELEASE.2022-02-16T00-35-27Z@sha256:73a2ec4fc91f32c2d5ab4c49b5f9496ee33ac9b67a8c061fa80b506cc16f4a6a
    container_name: bubblewrap-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      - TZ=Europe/Warsaw
      - MINIO_ROOT_USER=app
      - MINIO_ROOT_PASSWORD={{ bubblewrap_minio_password }}
    volumes:
      - /mnt/data/services/bubblewrap/minio:/data
    logging: *default-logging
  bubblewrap:
    image: ghcr.io/jakubdyszkiewicz/bubblewrap:sha-afabc86@sha256:fffe44b4f4fe33e067e58ca156507fb3b155bd22cc38c785e4296b2115bbcbed
    container_name: bubblewrap
    restart: unless-stopped
    environment:
      - API_PORT=8080
      - API_HOST=0.0.0.0
      - API_ALLOWED_ORIGINS="https://bubblewrap.{{ ant_domain}}"
      - DATABASE_URL=postgres://app:{{ bubblewrap_postgres_password }}@bubblewrap-postgres:5432/bubblewrap?sslmode=disable
      - MINIO_ENDPOINT=bubblewrap-minio:9000
      - MINIO_ACCESS_KEY=app
      - MINIO_SECRET_KEY={{ bubblewrap_minio_password }}
      - MINIO_BUCKET=family-media
      - AUTH_TOKEN_SECRET={{ bubblewrap_auth_token_secret }}
      - RESEND_API_KEY={{ resend_api_key }}
      - RESEND_FROM_EMAIL=no-reply@updates.{{ ant_domain }}
      - APP_BASE_URL=https://bubblewrap.{{ ant_domain }}
      - NEXT_PUBLIC_GOOGLE_CLIENT_ID={{ bubblewrap_google_client_id }}
      - GOOGLE_CLIENT_ID={{ bubblewrap_google_client_id }}
      - TRUST_PROXY_HEADERS=true
      - WEB_PUSH_VAPID_PUBLIC_KEY={{ bubblewrap_vapid_public_key }}
      - WEB_PUSH_VAPID_PRIVATE_KEY={{ bubblewrap_vapid_private_key }}
      - WEB_PUSH_VAPID_SUBJECT=mailto:jakub.dyszkiewicz@gmail.com
      - ACCOUNT_CREATION_ENABLED=false
    depends_on:
      bubblewrap-postgres:
        condition: service_healthy
      bubblewrap-minio:
        condition: service_started
    logging: *default-logging
  kroczek:
    image: ghcr.io/jakubdyszkiewicz/kroczek:sha-2c66a32@sha256:2f42552915b094d71551aa230221cd81e72d083bc4ccbe3e2b34e494fa29c632
    container_name: kroczek
    restart: unless-stopped
    environment:
      - DB_PATH=/app/data/baby-tracker.db
      - LISTEN_ADDR=0.0.0.0:8080
    volumes:
      - /mnt/data/services/kroczek:/app/data
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging: *default-logging
    ports:
      - 13002:8080
  terminus-init-certificates:
    image: ghcr.io/usetrmnl/terminus:0.84.0@sha256:78316a885994817162cbab2abfcb8d6ac3f49c1d58d89f36266765d9f760721f
    container_name: terminus-init-certificates
    user: root
    volumes:
      - terminus-certificates:/etc/ssl/certs
    entrypoint: ["/bin/bash", "-c"]
    command: scripts/docker/install-certificates
    restart: on-failure:3
    logging: *default-logging
  terminus:
    image: ghcr.io/usetrmnl/terminus:0.84.0@sha256:78316a885994817162cbab2abfcb8d6ac3f49c1d58d89f36266765d9f760721f
    container_name: terminus
    init: true
    environment:
      - APP_SETUP=true
      - HANAMI_PORT=2300
      - API_URI=http://{{ inventory_hostname }}:2300
      - APP_SECRET={{ terminus_app_secret }}
      - DATABASE_URL=postgres://terminus:{{ terminus_database_password }}@terminus-database:5432/terminus
      - KEYVALUE_URL=redis://:{{ terminus_keyvalue_password }}@terminus-keyvalue:6379/0
    ports:
      - "2300:2300"
    volumes:
      - terminus-certificates:/etc/ssl/certs
      - /mnt/data/services/terminus/fonts:/app/public/fonts
      - /mnt/data/services/terminus/fonts:/usr/share/fonts/terminus
      - /mnt/data/services/terminus/uploads:/app/public/uploads
    depends_on:
      terminus-init-certificates:
        condition: service_completed_successfully
      terminus-database:
        condition: service_healthy
      terminus-keyvalue:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent http://localhost:2300/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 45s
    restart: unless-stopped
    logging: *default-logging
  terminus-worker:
    image: ghcr.io/usetrmnl/terminus:0.84.0@sha256:78316a885994817162cbab2abfcb8d6ac3f49c1d58d89f36266765d9f760721f
    container_name: terminus-worker
    init: true
    environment:
      - HANAMI_PORT=2300
      - API_URI=http://{{ inventory_hostname }}:2300
      - APP_SECRET={{ terminus_app_secret }}
      - DATABASE_URL=postgres://terminus:{{ terminus_database_password }}@terminus-database:5432/terminus
      - KEYVALUE_URL=redis://:{{ terminus_keyvalue_password }}@terminus-keyvalue:6379/0
    command: bundle exec sidekiq -r ./config/sidekiq.rb
    volumes:
      - terminus-certificates:/etc/ssl/certs
      - /mnt/data/services/terminus/fonts:/app/public/fonts
      - /mnt/data/services/terminus/fonts:/usr/share/fonts/terminus
      - /mnt/data/services/terminus/uploads:/app/public/uploads
    depends_on:
      terminus:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "pgrep", "-f", "sidekiq"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 45s
    restart: unless-stopped
    logging: *default-logging
  terminus-database:
    image: postgres:18.7-alpine@sha256:ff64c9e3bdf8e2120107d3559de8db314e8305f7e38c5105903c6295876738ff
    container_name: terminus-database
    environment:
      - POSTGRES_USER=terminus
      - POSTGRES_DB=terminus
      - POSTGRES_PASSWORD={{ terminus_database_password }}
    volumes:
      - /mnt/data/services/terminus/postgres:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready --username terminus --dbname terminus --port 5432"]
      interval: 10s
      timeout: 5s
      retries: 3
    restart: unless-stopped
    logging: *default-logging
  terminus-keyvalue:
    image: valkey/valkey:9.2.0-alpine@sha256:c8e2d17498838af5d91e12eb7c11220b3434a7b7131a333e3af52ad5e0b80882
    container_name: terminus-keyvalue
    command: ["valkey-server", "--requirepass", "{{ terminus_keyvalue_password }}", "--maxmemory", "512mb", "--maxmemory-policy", "noeviction", "--port", "6379"]
    volumes:
      - /mnt/data/services/terminus/valkey:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli --no-auth-warning -a {{ terminus_keyvalue_password }} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 2s
    restart: unless-stopped
    logging: *default-logging
  tergeo:
    image: ghcr.io/jakubdyszkiewicz/tergeo:sha-b184a7b@sha256:ce941781de71f909b3a60b12f278de4d90d8682c51c82c5a35a3bfd323529c5e
    container_name: tergeo
    volumes:
      - /mnt/data/services/tergeo:/data
    expose:
      - 8080
    restart: unless-stopped
    logging: *default-logging
  terminus-screens:
    image: ghcr.io/jakubdyszkiewicz/terminus-screens:sha-9aa4c8b@sha256:7e78e6c38461494fd578bf5defd6283e94fe47f55852f62807b6fda91beff7ab
    container_name: terminus-screens
    environment:
      TERMINUS_SCREENS_TERGEO_URL: http://tergeo:8080/api/v1
      TERMINUS_SCREENS_ICAL_URL: {{ family_calendar_ical_url | to_json }}
      TERMINUS_SCREENS_TIMEZONE: Europe/Warsaw
    expose:
      - 8080
    depends_on:
      tergeo:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging

  sure-web:
    image: ghcr.io/jakubdyszkiewicz/sure-patched:v0.7.5-hotfix.1-patched@sha256:b716234fe6a014056fdba68e875eaf8856c1dea78bb2636234549c5ace449150
    container_name: sure-web
    environment: &sure-env
      SECRET_KEY_BASE: {{ sure_secret_key_base | to_json }}
      SELF_HOSTED: "true"
      DB_HOST: sure-db
      POSTGRES_USER: sure
      POSTGRES_PASSWORD: {{ sure_postgres_password | to_json }}
      REDIS_URL: redis://sure-redis:6379/1
    volumes:
      - /mnt/data/services/sure/storage:/rails/storage
    expose:
      - 3000
    depends_on:
      sure-db:
        condition: service_healthy
      sure-redis:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
  sure-worker:
    image: ghcr.io/jakubdyszkiewicz/sure-patched:v0.7.5-hotfix.1-patched@sha256:b716234fe6a014056fdba68e875eaf8856c1dea78bb2636234549c5ace449150
    container_name: sure-worker
    command: bundle exec sidekiq
    environment: *sure-env
    volumes:
      - /mnt/data/services/sure/storage:/rails/storage
    depends_on:
      sure-db:
        condition: service_healthy
      sure-redis:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
  sure-db:
    image: postgres:16.16@sha256:3950ad7c3148ca2175ef1b6c36c9efbf78957ae8fbe8b3a5d7c35af50500382f
    container_name: sure-db
    environment:
      POSTGRES_USER: sure
      POSTGRES_PASSWORD: {{ sure_postgres_password | to_json }}
      POSTGRES_DB: sure_production
    volumes:
      - /mnt/data/services/sure/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sure -d sure_production"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging: *default-logging
  sure-redis:
    image: redis:8.10.3@sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
    container_name: sure-redis
    volumes:
      - /mnt/data/services/sure/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging: *default-logging

  tailscale-cleaner:
    image: ghcr.io/jakubdyszkiewicz/tailscale-cleaner:0.1.0@sha256:f98c2bbfe14cf4415fd2d81209c48ac48b5ae407ca676fa0aeb7f31f89c5c099
    container_name: tailscale-cleaner
    environment:
      - TAILSCALE_API_TOKEN={{ tailscale_api_key }}
      - TAGS=tag:isodev
    command: ["-mode", "interval"]
    restart: unless-stopped
    logging: *default-logging

volumes:
  terminus-certificates:
